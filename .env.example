DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_system?schema=public"

AUTH_SECRET="replace-with-a-long-random-string"

# PHP gateway (cPanel) — the Next.js server calls this instead of talking
# to Postgres directly for anything converted to use lib/database/gateway-client.ts.
# DB_GATEWAY_SECRET must match GATEWAY_SECRET in php-gateway/config.php exactly.
DB_GATEWAY_URL="https://wonderbizz.top/db/gateway.php"
DB_GATEWAY_SECRET="replace-with-a-long-random-string"

MPESA_ENV="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_PASSKEY=""
MPESA_SHORTCODE=""
MPESA_CALLBACK_URL="https://your-domain.example.com/api/webhooks/mpesa"

PESAPAL_ENV="sandbox"
PESAPAL_CONSUMER_KEY=""
PESAPAL_CONSUMER_SECRET=""
PESAPAL_IPN_ID=""
PESAPAL_IPN_URL="https://your-domain.example.com/api/webhooks/pesapal"

CARD_PROVIDER="stub"
CARD_API_KEY=""
CARD_WEBHOOK_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
